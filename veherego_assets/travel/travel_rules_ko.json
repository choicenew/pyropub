{
  "schema_version": 1,
  "locale": "ko",
  "region": "KR",
  "description": "VehereGo 글로벌 교통/여행 티켓 독립 룰팩 (한국어·대한민국 지역)",
  "transit_types": {
    "train": {
      "type_name": "기차/KTX/SRT",
      "text_triggers": [
        "KTX",
        "SRT",
        "ITX",
        "무궁화호",
        "열차",
        "승차권",
        "타는곳",
        "호차",
        "좌석",
        "출발",
        "도착",
        "코레일"
      ],
      "service_number_patterns": [
        "(?:KTX|SRT|ITX|무궁화)\\s*(\\d{1,4})\\s*호?",
        "([A-Za-z0-9]{2,6}\\s*\\d{1,4})"
      ],
      "gate_patterns": [
        "(\\d{1,2}번\\s*타는곳|타는곳[：:\\s]*\\d{1,2})"
      ],
      "seat_patterns": [
        "(\\d{1,2}호차\\s*\\d{1,2}[A-D]석?)"
      ],
      "class_keywords": [
        "특실",
        "일반실",
        "자유석",
        "입석"
      ]
    },
    "flight": {
      "type_name": "항공권/탑승권",
      "text_triggers": [
        "항공권",
        "탑승권",
        "탑승구",
        "터미널",
        "좌석",
        "이코노미",
        "비즈니스",
        "대한항공",
        "아시아나"
      ],
      "service_number_patterns": [
        "([A-Z0-9]{2}\\s*\\d{3,4})",
        "(?:편명|항공편)[：:\\s]*([A-Z0-9]{2}\\s*\\d{3,4})"
      ],
      "gate_patterns": [
        "(?:탑승구|게이트)[：:\\s]*([A-Z0-9]{1,4})"
      ],
      "seat_patterns": [
        "(?:좌석)[：:\\s]*([A-Z0-9]{2,4})"
      ]
    },
    "bus": {
      "type_name": "고속버스/시외버스",
      "text_triggers": [
        "고속버스",
        "시외버스",
        "버스터미널",
        "승차홈",
        "좌석"
      ],
      "gate_patterns": [
        "(\\d{1,2}번\\s*승차홈)"
      ],
      "seat_patterns": [
        "(\\d{1,2}번\\s*좌석)"
      ]
    },
    "ferry": {
      "type_name": "여객선/페리",
      "text_triggers": [
        "여객선",
        "페리",
        "여객터미널",
        "선착장",
        "선실"
      ],
      "gate_patterns": [
        "(\\d{1,2}번\\s*선착장)"
      ],
      "seat_patterns": [
        "(\\d{1,2}등실|\\d{1,2}번)"
      ]
    }
  },
  "type": "travel_rules",
  "version": 1
}