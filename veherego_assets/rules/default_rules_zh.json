        "餐点",
        "就餐",
        "打包",
        "堂食"
      ]
    },
    "multi_clusters": {
      "cluster_patterns": [
        "(?:取件码|提取码|自提码|取货码)[为是：:\\s]*([A-Za-z0-9-]{3,20}(?:\\s*[,，、;；\\s]\\s*[A-Za-z0-9-]{3,20})*)"
      ],
      "by_patterns": [
        "凭\\s*(\\d{1,6}(?:-\\d{1,4}){1,2}|[A-Za-z]?\\d{4,9})(?=[到去取领，。,\\s]|$)"
      ]
    }
  },
