      "门店地址",
      "店铺地址",
      "取货地址",
      "自提地址",
      "取餐地址",
      "就餐地点",
      "取件地址",
      "柜机地址",
      "自提点",
      "提货点",
      "所在位置"
    ],
    "sentence_patterns": [
      "(?:请凭.*(?:已到|已至|到达|到了|在|于|前往|送到|到|至)|请前往|凭码至|请至|凭短信到)\\s*([^\\n,，。]{3,30}(?:驿站|自提点|柜|店|堂食|服务点))",
      "(?:到|在)([\\u4e00-\\u9fa5A-Za-z0-9]{2,30}?(?:店|站|柜|点|自提))"
    ],
    "store_patterns": [
      "([\\p{L}\\p{N}]{2,20}(?:店|分店|旗舰店|专卖店|体验店|商铺))"
    ],
    "road_patterns": [
      "([\\p{L}\\p{N}]{2,20}(?:路|街|道|巷|弄|胡同)\\s*\\d{1,4}\\s*号?)"
    ],
    "transit_patterns": [
      "([\\p{L}\\p{N}]{2,15}(?:站[A-Z0-9出入口口]*|航站楼|火车站|机场|客运站))"
    ],
    "business_hour_keywords": [
      "营业时间",
      "工作时间",
      "取件时间"
    ]
